---
// Every page's frame: the head (the taste-skill kit, the fonts, the palette), the bar, the footer and the
// scripts. Dark is the default; the bar's theme button switches to light and the choice is kept.
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description: string;
  current?: 'evidence' | 'architecture' | 'artifacts';
  doc?: boolean;
  extraCss?: string[];
}
const { title, description, current, doc = false, extraCss = [] } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/brand/graftyard-og-1200x630.png', Astro.site).href;

const pages = [
  { key: 'evidence', href: '/evidence/', label: 'Evidence' },
  { key: 'architecture', href: '/architecture/', label: 'Architecture' },
  { key: 'artifacts', href: '/why-not-artifacts/', label: 'Why not Artifacts' },
];
const sun = '<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="3.6"/><path d="M10 1.8v2.4M10 15.8v2.4M1.8 10h2.4M15.8 10h2.4M4.2 4.2l1.7 1.7M14.1 14.1l1.7 1.7M4.2 15.8l1.7-1.7M14.1 5.9l1.7-1.7"/></svg>';
---
<!doctype html>
<html lang="en" data-theme="dark" data-type="software" data-radius="sharp" data-ground="sage" data-buttons="pill" data-motion>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={url}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Graftyard">
<meta property="og:url" content={url}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Graftyard: “Claude, rebuild GitHub. Make no mistakes. Oh, and do it in Rust.” Git hosting compatible with GHES 3.22.">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<meta name="site-kind" content="software">
<meta name="page-type" content="software">
<meta name="color-scheme" content="dark light">
<script is:inline>try { if (localStorage.getItem('gy-theme') === 'light') document.documentElement.dataset.theme = 'light'; } catch (e) {}</script>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Geist+Mono:wght@400..500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/system.css">
<link rel="stylesheet" href="/assets/ui/cards.css">
<link rel="stylesheet" href="/assets/motion/motion.css">
<link rel="stylesheet" href="/assets/backgrounds/backgrounds.css">
<link rel="stylesheet" href="/assets/layout/layout.css">
<link rel="stylesheet" href="/assets/icons/icon.css">
<link rel="stylesheet" href="/assets/ui/base.css">
{extraCss.map((href) => <link rel="stylesheet" href={href}>)}
<link rel="stylesheet" href="/assets/diagrams/diagram.css">
<script is:inline src="/assets/backgrounds/backgrounds.js"></script>
<!-- brand: ground #0f2a1d (the logo's wordmark green, the films' ground), ink #f6f7f3, accent #9cc253 (the leaf);
     light is the earlier palette turned round -->
<style is:global>
:root, html[data-theme="dark"] {
  --p-bg: #0f2a1d; --p-surface: #16352a; --p-ink: #f6f7f3; --p-muted: #a9b5ac;
  --p-accent: #9cc253; --p-accent-ink: #10240f; --p-action: #9cc253; --p-action-ink: #0f2a1d;
  --p-inv-bg: #f6f7f3; --p-inv-surface: #e9ece7; --p-inv-ink: #0f2a1d; --p-inv-muted: #596b60;
  --p-inv-accent: #4f7a1f; --p-inv-accent-ink: #ffffff; --p-inv-action: #0f2a1d; --p-inv-action-ink: #f6f7f3;
}
html[data-theme="light"] {
  --p-bg: #f6f7f3; --p-surface: #e9ece7; --p-ink: #0f2a1d; --p-muted: #596b60;
  --p-accent: #9cc253; --p-accent-ink: #111111; --p-action: #0f2a1d; --p-action-ink: #f6f7f3;
  --p-inv-bg: #0f2a1d; --p-inv-surface: #1e3629; --p-inv-ink: #f6f7f3; --p-inv-muted: #97a39a;
  --p-inv-accent: #9cc253; --p-inv-accent-ink: #111111; --p-inv-action: #9cc253; --p-inv-action-ink: #111111;
}
/* the lit ground (the hero window, the closing slab) a step above the dark page */
html[data-ground][data-theme="dark"] { --ground-bg: #1b3d2c; --ground-surface: #224632; --ground-ink: #f6f7f3; --ground-muted: #b4c1b7; --ground-accent: #9cc253; }
:root {
  --font-display: "Geist", system-ui, sans-serif;
  --font-text: "Geist", system-ui, sans-serif;
  --font-mono: "Geist Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
  --display-weight: 500;
  --display-tracking: -0.035em;
  --display-tracking-xl: -0.045em;
}
/* .nav__logo .gy-logo outranks the kit's `.nav__logo svg { height: 24px }` */
.gy-logo, .nav__logo .gy-logo { display: block; height: 36px; width: auto; color: var(--ink); }
@media (max-width: 639px) { .nav__logo .gy-logo { height: 32px; } }
.footer .nav__logo .gy-logo { height: 52px; }
/* the logo's two branches are deep green, which a dark page swallows: there they take the ink, as in the films */
html[data-theme="dark"] .gy-logo .gy-br { fill: var(--ink); }
/* the theme button: the menu button's look, kept in the bar at every width */
.theme-btn { display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: var(--r-btn); border: 1px solid var(--line-strong);
  background: transparent; color: var(--ink); cursor: pointer; flex: none; padding: 0; }
.theme-btn svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; }
.theme-btn:hover { background: color-mix(in oklab, var(--ink) 8%, transparent); }
html[data-theme="light"] .theme-btn circle { fill: currentColor; }
.nav:not(.is-open) .nav__actions > .theme-btn { display: inline-grid; }
@media (max-width: 1023px) { .nav.is-open .nav__actions > .theme-btn { width: 100%; height: 48px; } }
/* Sections take their content's height at every size, parted by their padding. The kit's one-screen
   sections left an empty band under each of ours, which are shorter than a screen, and let taller
   content on a short phone run under the next section. */
main > section.section:not(.hero), body > footer.closing {
  height: auto; min-height: 0; display: flex; flex-direction: column;
}
main > section.section:not(.hero) > .wrap, body > footer.closing > .wrap { flex: none; height: auto; min-height: 0; }
/* one rhythm on every page: a section starts --s-9 under the last one (--s-8 on a phone), with no
   bottom padding, so the gap between two sections is that one space, not the kit's 120 + 72 */
main > section.section:not(.hero) { padding-block: var(--s-9) 0; scroll-margin-top: var(--nav); }
main > section.section:not(.hero):last-child { padding-bottom: var(--s-10); }
@media (max-width: 639px) {
  main > section.section:not(.hero) { padding-top: var(--s-8); }
  main > section.section:not(.hero):last-child { padding-bottom: var(--s-9); }
}
/* a reading page (evidence, architecture, Artifacts) */
main.doc > section.section > .wrap { flex: none; }
main.doc > section.section:first-child { padding-top: calc(var(--nav) + var(--s-9)); }
main.doc > section.section:last-child { padding-bottom: var(--s-10); }
@media (max-width: 639px) {
  main.doc > section.section { padding-top: var(--s-8); }
  main.doc > section.section:first-child { padding-top: calc(var(--nav) + var(--s-7)); }
  main.doc > section.section:last-child { padding-bottom: var(--s-9); }
}
/* 44px tap areas on the small links, without changing how they look */
.nav .nav__logo { min-height: 44px; }
.pill, .link { position: relative; }
.pill::before, .link::before { content: ""; position: absolute; inset: -8px -4px; }
/* under 360px the bar keeps the mark, the theme button and the menu button on one line */
@media (max-width: 359px) {
  .nav .nav__logo { width: 32px; overflow: hidden; justify-content: flex-start; }
  .nav .nav__logo .gy-logo { flex: none; height: 32px; max-width: none; }
}
@media (max-width: 1023px) { main [data-visual] { margin-top: var(--s-6); } }

/* ---- shared page parts */
.facts { display: grid; gap: var(--s-4); margin: var(--s-6) 0 0; padding: 0; list-style: none; }
.facts > li { padding-top: var(--s-4); border-top: 1px solid var(--line); }
.facts b { font-weight: 500; color: var(--ink); }
.more { margin-top: var(--s-6); }
code, .mono { font-family: var(--font-mono); font-size: 0.92em; }
.dt code { white-space: nowrap; }
.eyebrow { font: 500 var(--t-small)/1.4 var(--font-text); color: var(--accent); letter-spacing: 0; }
html[data-theme="light"] .eyebrow { color: #4f7a1f; }
.doc-head { display: grid; gap: var(--s-5); max-width: 860px; }
.doc-head h1 { font-size: clamp(40px, 3.4vw + 22px, 72px); line-height: 1.02; letter-spacing: var(--display-tracking-xl); text-wrap: balance; }
.doc-head .t-lead { max-width: 60ch; color: var(--ink); }
.prose { display: grid; gap: var(--s-4); max-width: 68ch; }
.prose p, .prose li { color: var(--ink); }
.prose ul, .prose ol { display: grid; gap: var(--s-3); padding-left: 1.2em; margin: 0; }
.prose li::marker { color: var(--muted); }
.note { font-size: var(--t-small); color: var(--muted); margin-top: var(--s-4); max-width: 80ch; }
.sec-head { display: grid; gap: var(--s-4); max-width: 760px; margin-bottom: var(--s-7); }
.sec-head p { font-size: var(--t-lead); line-height: 1.5; max-width: 60ch; }
/* big figures in a row: three a row on a desktop, two on a tablet, one on a phone */
.kpis { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-7) var(--gutter); margin-top: var(--s-8); padding: 0; list-style: none; }
.kpis > li { display: grid; gap: var(--s-2); align-content: start; padding-top: var(--s-4); border-top: 1px solid var(--line); min-width: 0; }
.kpis b { font: var(--display-weight) clamp(32px, 1.8vw + 22px, 52px)/1.05 var(--font-display); letter-spacing: var(--display-tracking); color: var(--ink); overflow-wrap: anywhere; }
.kpis span { color: var(--muted); font-size: var(--t-small); max-width: 34ch; }
@media (max-width: 1023px) { .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 479px) { .kpis { grid-template-columns: minmax(0, 1fr); gap: var(--s-5); } }
/* a table that turns into labelled rows on a phone, so it never scrolls sideways */
.dt { width: 100%; border-collapse: collapse; font-size: var(--t-small); line-height: 1.5; margin-top: var(--s-6); }
.dt th { text-align: left; font-weight: 500; color: var(--muted); padding: 0 var(--s-4) var(--s-3) 0; border-bottom: 1px solid var(--line-strong); vertical-align: bottom; }
.dt td { padding: var(--s-4) var(--s-4) var(--s-4) 0; border-bottom: 1px solid var(--line); vertical-align: top; color: var(--ink); }
.dt td:first-child { font-weight: 500; }
.dt th:last-child, .dt td:last-child { padding-right: 0; }
.dt .ok { color: var(--accent); font-weight: 500; }
.dt .no { color: #f0a868; font-weight: 500; }
html[data-theme="light"] .dt .ok { color: #3f6a12; }
html[data-theme="light"] .dt .no { color: #a14b0c; }
@media (max-width: 767px) {
  .dt thead { display: none; }
  .dt, .dt tbody, .dt tr, .dt td { display: block; }
  .dt tr { padding: var(--s-4) 0; border-bottom: 1px solid var(--line); }
  .dt td { border: 0; padding: var(--s-1) 0; display: grid; grid-template-columns: minmax(0, 7.5em) minmax(0, 1fr); gap: var(--s-3); }
  .dt td::before { content: attr(data-label); color: var(--muted); }
  .dt td:first-child { display: block; font-size: var(--t-body); padding-bottom: var(--s-2); }
  .dt td:first-child::before { content: none; }
  .dt code { white-space: normal; overflow-wrap: anywhere; }
}
/* a film: a silent loop in a frame on the films' own ground (#0f2a1d, the dark page's own green, so in dark the
   film has no visible edge), its pause button in a strip under it, so at no width does it sit on the picture */
.frame--film { padding: 0; background: #0f2a1d; border: 0; --ratio: 64%; }
.frame--film::before { padding-top: calc(var(--ratio) + 48px); }
/* .frame.frame--film: the kit's `.frame > :not(...)` puts every child in the flow, and outranks one class */
.frame.frame--film > video { position: absolute; inset: 0; width: 100%; height: calc(100% - 48px); object-fit: contain; }
.frame--film > .loop-pause { right: 0; bottom: 8px; }
html[data-theme="light"] .frame--film > .loop-pause { right: 8px; }
@media (min-width: 640px) and (max-width: 1023px) { .frame--film { --ratio: 56%; } }
@media (max-width: 639px) { .frame--film { --ratio: 80%; } }
</style>
<slot name="head" />
</head>
<body>
<header class="nav nav--centre">
  <div class="wrap nav__bar">
    <a class="nav__logo" href="/" aria-label="Graftyard home"><Logo /></a>
    <nav class="nav__links" aria-label="Main">
      {pages.map((p) => <div class="nav__item"><a class="nav__link" href={p.href} aria-current={current === p.key ? 'page' : undefined}>{p.label}</a></div>)}
    </nav>
    <div class="nav__actions">
      <button class="theme-btn" type="button" data-theme-toggle aria-label="Switch to light theme"><Fragment set:html={sun} /></button>
    </div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menu">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
  </div>
</header>

<main id="top" class:list={[{ doc }]}>
  <slot />
</main>

<footer class="footer closing footer--statement" id="contact" aria-labelledby="close-h">
  <div class="wrap">
    <div class="closing__cta close--type">
      <div class="section-head">
        <h2 id="close-h">Move off GHES without moving your tools</h2>
        <p>Every figure on this site comes from a test run you can read about.</p>
      </div>
      <a class="btn btn--primary btn--xl btn--wide" href="/evidence/">See the evidence<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></a>
    </div>
    <div class="closing__links">
      <div class="grid">
        <div class="span-4 stack-4">
          <a class="nav__logo" href="/" aria-label="Graftyard home"><Logo /></a>
          <p class="footer__lede">Git hosting for GitHub clients, on Cloudflare.</p>
        </div>
        <div class="span-2 start-9 footer__col"><h4>Graftyard</h4><ul><li><a href="/#ghes">GHES 3.22</a></li><li><a href="/#durability">Durability</a></li><li><a href="/#questions">Questions</a></li></ul></div>
        <div class="span-2 footer__col"><h4>Read more</h4><ul>{pages.map((p) => <li><a href={p.href}>{p.label}</a></li>)}</ul></div>
      </div>
      <div class="footer__legal">
        <span>&copy; 2026 Graftyard</span>
        <span class="credits">Product names and logos are trademarks of their owners. GitHub Enterprise Server is a GitHub product, and Cloudflare Artifacts a Cloudflare product; Graftyard is affiliated with neither.</span>
      </div>
    </div>
  </div>
</footer>

<script is:inline type="module" src="/assets/system.js"></script>
<script is:inline type="module" src="/assets/motion/motion.js"></script>
<script is:inline type="module" src="/assets/layout/layout.js"></script>
<script is:inline type="module" src="/assets/diagrams/mount.js"></script>
<script is:inline>
  // one page view per load, to the site Worker's /_v, which sends it to Basin (worker.js)
  try { navigator.sendBeacon('/_v', JSON.stringify({ p: location.pathname, r: document.referrer, w: innerWidth, t: document.documentElement.dataset.theme || 'dark' })); } catch (e) {}
</script>
<script is:inline type="module">
  // the theme: dark unless the visitor chose light. The page tone and the hero's effect follow at once.
  const html = document.documentElement;
  const btn = document.querySelector('[data-theme-toggle]');
  const label = () => btn.setAttribute('aria-label', html.dataset.theme === 'light' ? 'Switch to dark theme' : 'Switch to light theme');
  label();
  btn.addEventListener('click', async () => {
    const next = html.dataset.theme === 'light' ? 'dark' : 'light';
    html.dataset.theme = next;
    html.dataset.tone = next;
    try { localStorage.setItem('gy-theme', next); } catch (e) {}
    label();
    const fx = (await import('/assets/effects/fx.js')).default;
    document.querySelectorAll('[data-fx-mounted]').forEach((el) => fx.get(el)?.setPalette(fx.readPalette(el)));
  });

  // the films: play while on screen, rest on the poster under reduced motion, and one pause button each (WCAG 2.2.2)
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const pauseIcon = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 3h3v10H4zM9 3h3v10H9z"/></svg>';
  const playIcon = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3l8 5-8 5z"/></svg>';
  const io = new IntersectionObserver((entries) => entries.forEach((e) => {
    const v = e.target;
    if (e.isIntersecting && !v.dataset.held && !still) v.play().catch(() => {});
    else v.pause();
  }), { threshold: 0.25 });
  document.querySelectorAll('.frame--film').forEach((frame) => {
    const film = frame.querySelector('video');
    const pause = frame.querySelector('[data-film-pause]');
    io.observe(film);
    if (still) pause.hidden = true;
    pause.addEventListener('click', () => {
      const play = film.paused;
      if (play) { delete film.dataset.held; film.play(); } else { film.dataset.held = '1'; film.pause(); }
      pause.setAttribute('aria-label', play ? 'Pause the film' : 'Play the film');
      pause.innerHTML = play ? pauseIcon : playIcon;
    });
  });
</script>
</body>
</html>
