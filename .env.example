# Environment the hosted test harnesses under tests/ read. Copy to .env (git-ignored) or export these yourself.
# Product code reads none of them.

# Cloudflare account that holds the test installs, and its workers.dev subdomain (<name>.workers.dev).
CLOUDFLARE_ACCOUNT_ID=
CF_WORKERS_SUBDOMAIN=
CLOUDFLARE_API_TOKEN=

# Separate account for hosted Actions runners (M4-WP4), and its workers.dev subdomain.
CLOUDFLARE_RUNNER_ACCOUNT_ID=
CF_RUNNER_WORKERS_SUBDOMAIN=
CLOUDFLARE_RUNNER_API_TOKEN=

# Zone for the SSH front bed (M0-WP7) and deploy/oci-ssh.
CF_ZONE_ID=
