// M0-WP13: graft-wp13-hooks, the webhook receivers of every App in the fixture. Each App's URL is a path here.
{
  "name": "graft-wp13-hooks",
  "main": "../../src/agent/hooks.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "LOG", "class_name": "HookLog" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HookLog"] }]
}
