{
  // m0-carried-6's B0-02 test edge on graft-m3d: the M1-WP2 test edge (tests/m1/wp2/edge.ts) bound to the graft-m3d
  // sites' Member classes. A separate script, so deploying it creates no site version and leaves graft-m3d-edge alone.
  "name": "graft-m3d-wp2-edge",
  "main": "../m1/wp2/edge.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": { "bindings": [
    { "name": "MEMBER_0", "class_name": "Member", "script_name": "graft-m3d-site-a" },
    { "name": "MEMBER_1", "class_name": "Member", "script_name": "graft-m3d-site-b" },
    { "name": "MEMBER_2", "class_name": "Member", "script_name": "graft-m3d-site-c" }
  ] },
  "observability": { "enabled": true }
}
